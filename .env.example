# EXO Broker - environment variables template.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Supabase (issue #2) ---
# Public: exposed to the browser. Protected by RLS, safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY: bypasses RLS. Never prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Insurer adapters (lib/insurers) ---
# Mode per insurer: mock | sandbox | production
INSURER_MODE_MERCANTIL=mock
INSURER_MODE_FEDPAT=mock

# SERVER-ONLY: insurer credentials (only needed in sandbox/production mode).
MERCANTIL_API_URL=
MERCANTIL_API_KEY=
FEDPAT_API_URL=
FEDPAT_CLIENT_ID=
FEDPAT_CLIENT_SECRET=

# --- App ---
# Public base URL (used for auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
